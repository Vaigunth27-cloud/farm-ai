graph TB
    subgraph Data_Acquisition["1. Data Acquisition Subsystem"]
        IMG_SRC["Street Level Imagery Sources"]
        IMG_SRC --> OPT_A["Option A: Place Search & Viewport Capture<br/><i>(MapLibre / Geocoding / Canvas Capture)</i> [IMPLEMENTED]"]
        IMG_SRC --> OPT_B["Option B: Batch Image Upload<br/><i>(Drag & Drop / Multi-file / EXIF Parser)</i> [IMPLEMENTED]"]
        IMG_SRC --> CAM_ARCH["Historical Dashcam / Corridor Archive<br/><i>(108 frames / 10 Corridors in Ward 29)</i> [IMPLEMENTED]"]
    end

    subgraph Preprocessing_Validation["2. Ingestion & Quality Control"]
        VAL["Image Format & Integrity Validator [IMPLEMENTED]"]
