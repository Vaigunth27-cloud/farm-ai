        NORM --> YOLO
        YOLO --> CONF_FILT
        NORM --> OCR
        CONF_FILT --> VLM_ROUTER
    end

    subgraph Human_Verification["4. Human Verification & Active Learning"]
        QA_REV["Tri-View Studio & QA Slider Review<br/><i>(Original vs Detection vs 3D)</i> [IMPLEMENTED]"]
        LABEL_ADJ["Bounding Box & Class Correction [IN PROGRESS]"]
